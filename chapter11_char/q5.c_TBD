# include<stdio.h>

char StimuStr(char a[],char b[],int n,int m){
    char ch ;
    for (i=0;i<n;i++){
        if (a[i]==b[0]){
            ch = b[0] ;
        }
        else {
            ch = null ;
        }
        }
    }
    return ch ;
}

